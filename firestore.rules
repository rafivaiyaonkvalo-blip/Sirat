rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() { return request.auth != null; }
    // অ্যাডমিন: শুধু যাচাইকৃত এই ইমেইল (src/utils/superUser.js-এর SUPER_USER_EMAIL-এর সাথে মিলিয়ে রাখুন)
    function isAdmin() { return signedIn() && request.auth.token.email_verified == true && request.auth.token.email == 'rafi.vaiya.onk.valo@gmail.com'; }

    // সম্মিলিত দুরূদ গণনা: সবাই পড়তে পারে; লেখা শুধু count (একবারে ১–২০০ বাড়ানো),
    // participants (একবারে ১) ও countries (একবারে একটি দেশ) বাড়ানো যায়; অ্যাডমিন সব নিয়ন্ত্রণ ও রিসেট করতে পারে।
    match /campaigns/durood {
      allow read: if true;
      allow update: if (request.resource.data.diff(resource.data).affectedKeys().hasOnly(['count', 'participants', 'countries'])
        && request.resource.data.count is int
        && request.resource.data.count - resource.data.count >= 1
        && request.resource.data.count - resource.data.count <= 200
        && (!('participants' in request.resource.data.diff(resource.data).affectedKeys()) || request.resource.data.participants - resource.data.get('participants', 0) == 1)
        && (!('countries' in request.resource.data.diff(resource.data).affectedKeys()) || request.resource.data.countries.diff(resource.data.get('countries', {})).affectedKeys().size() == 1))
        || isAdmin();
      allow write: if isAdmin();
    }

    // লিডারবোর্ড (পাবলিক: ইমেইল/ফোন নেই): সবাই পড়তে পারে; শুধু নিজের ডক নিজে লেখা যায় (দুরূদ/XP শুধু বাড়ে,
    // total আর durood সমান হারে বাড়ে; refCode একবার বসালে বদলায় না)। রেফারেলে আসা দুরূদ এখানে নয়, refcodes/{code}-এ জমে।
    match /leaderboard/{uid} {
      allow read: if true;
      allow create: if signedIn() && request.auth.uid == uid
        && request.resource.data.keys().hasOnly(['name', 'photoURL', 'hideName', 'durood', 'xp', 'total', 'refCode', 'week', 'weekDurood', 'updatedAt'])
        && request.resource.data.durood is int && request.resource.data.durood >= 0 && request.resource.data.durood <= 1000000
        && request.resource.data.xp is int && request.resource.data.xp >= 0 && request.resource.data.xp <= 100000000
        && request.resource.data.total == request.resource.data.durood
        && (!('refCode' in request.resource.data) || request.resource.data.refCode.size() in [7, 12])
        && (!('week' in request.resource.data) || (request.resource.data.week.size() == 10 && request.resource.data.weekDurood is int && request.resource.data.weekDurood >= 0 && request.resource.data.weekDurood <= request.resource.data.durood));
      allow update: if (signedIn() && request.auth.uid == uid
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['name', 'photoURL', 'hideName', 'durood', 'xp', 'total', 'refCode', 'week', 'weekDurood', 'updatedAt'])
          && request.resource.data.durood - resource.data.get('durood', 0) >= 0
          && request.resource.data.durood - resource.data.get('durood', 0) <= 20000
          && request.resource.data.xp - resource.data.get('xp', 0) >= 0
          && request.resource.data.xp - resource.data.get('xp', 0) <= 1000000
          && request.resource.data.total - resource.data.get('total', 0) == request.resource.data.durood - resource.data.get('durood', 0)
          && (!('refCode' in resource.data) || request.resource.data.refCode == resource.data.refCode)
          && (!('refCode' in request.resource.data) || request.resource.data.refCode.size() in [7, 12])
          && (!('week' in request.resource.data) || (request.resource.data.week.size() == 10 && request.resource.data.weekDurood is int && request.resource.data.weekDurood >= 0 && request.resource.data.weekDurood <= request.resource.data.durood
            && (request.resource.data.week == resource.data.get('week', '')
              ? request.resource.data.weekDurood - resource.data.get('weekDurood', 0) >= 0 && request.resource.data.weekDurood - resource.data.get('weekDurood', 0) <= 20000
              : request.resource.data.weekDurood <= 20000))))
        || isAdmin();
      allow delete: if isAdmin();
    }

    // রেফারেল-কোড (লগইন ছাড়াই): প্রতিটি কোডের গণনা। যে-কেউ ১২ অক্ষরের কোডে শূন্য-ডক বানাতে পারে,
    // আর লিংকে আসা দর্শকের দুরূদ referred (একবারে ১–২০০) ও referredPeople (একবারে ১) বাড়াতে পারে;
    // সাপ্তাহিক weekReferred ওই বাড়তির সমান (সপ্তাহ বদলালে নতুন করে শুরু)।
    match /refcodes/{code} {
      allow read: if true;
      allow create: if code.size() in [7, 12] && request.resource.data.keys().hasOnly(['referred', 'referredPeople'])
        && request.resource.data.referred == 0 && request.resource.data.referredPeople == 0;
      allow update: if request.resource.data.diff(resource.data).affectedKeys().hasOnly(['referred', 'referredPeople', 'week', 'weekReferred'])
        && request.resource.data.referred - resource.data.get('referred', 0) >= 1
        && request.resource.data.referred - resource.data.get('referred', 0) <= 200
        && request.resource.data.referredPeople - resource.data.get('referredPeople', 0) >= 0
        && request.resource.data.referredPeople - resource.data.get('referredPeople', 0) <= 1
        && (request.resource.data.diff(resource.data).affectedKeys().hasOnly(['referred', 'referredPeople'])
          || (request.resource.data.week.size() == 10
            && (request.resource.data.week == resource.data.get('week', '')
              ? request.resource.data.weekReferred - resource.data.get('weekReferred', 0) == request.resource.data.referred - resource.data.get('referred', 0)
              : request.resource.data.weekReferred == request.resource.data.referred - resource.data.get('referred', 0))));
      allow delete: if isAdmin();
    }

    // নোট ও বুকমার্ক: শুধু নিজে পড়তে-লিখতে পারে (সর্বোচ্চ ৪০০টি)
    match /notes/{uid} {
      allow read, delete: if signedIn() && request.auth.uid == uid;
      allow create, update: if signedIn() && request.auth.uid == uid && request.resource.data.keys().hasOnly(['items', 'updatedAt']) && request.resource.data.items.size() <= 400;
    }

    // শিক্ষার্থীর প্রোফাইল ও অগ্রগতি: প্রত্যেকে শুধু নিজেরটা পড়তে ও লিখতে পারে; অ্যাডমিন সবটা পারে।
    // (লিডারবোর্ড অন্যের তথ্য পড়ে, তাই সেটা চালু করতে আলাদা পাবলিক সংগ্রহ লাগবে।)
    match /users/{uid} {
      allow read, create, update: if (signedIn() && request.auth.uid == uid) || isAdmin();
      allow delete: if isAdmin();
    }

    // ত্রুটির রিপোর্ট: যে কেউ পাঠাতে পারে; শুধু অ্যাডমিন দেখতে ও বদলাতে পারে
    match /reports/{id} {
      allow create: if true;
      allow read, update, delete: if isAdmin();
    }

    match /announcements/{id} { allow read: if true; allow write: if isAdmin(); }

    // ব্যবহার-পরিসংখ্যান: যে কেউ লিখতে পারে; শুধু অ্যাডমিন পড়তে পারে
    match /analytics_sessions/{id} { allow create, update: if true; allow read, delete: if isAdmin(); }
    match /analytics_daily/{id} { allow create, update: if true; allow read, delete: if isAdmin(); }
  }
}
