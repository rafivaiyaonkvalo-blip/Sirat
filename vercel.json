{
  "version": 2,
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "framework": "vite",
  "rewrites": [
    { "source": "/sirat/assets/(.*)", "destination": "/assets/$1" },
    { "source": "/sirat/(.*)", "destination": "/$1" },
    { "source": "/sirat", "destination": "/index.html" },
    { "source": "/((?!assets/).*)", "destination": "/index.html" }
  ]
}
